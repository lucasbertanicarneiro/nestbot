# =========================================================
# NestBot :: copie para .env e preencha
#   cp .env.example .env
# NUNCA versione o .env de verdade (ja esta no .gitignore)
# =========================================================

# --- Postgres ---
POSTGRES_DB=nestbot
POSTGRES_USER=nestbot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# --- Groq (console.groq.com/keys) ---
GROQ_API_KEY=cole_sua_chave_aqui
GROQ_MODELO_GERACAO=openai/gpt-oss-120b
GROQ_MODELO_RAPIDO=openai/gpt-oss-20b
# Modelo com visao, usado so pelo importador (docker compose --profile import).
# Confirme o nome ativo em console.groq.com/docs/models -- catalogo muda.
GROQ_MODELO_VISAO=qwen/qwen3.6-27b

# --- Telegram (peca ao @BotFather) ---
TELEGRAM_BOT_TOKEN=cole_o_token_aqui
# Deixe vazio em desenvolvimento local (usa polling).
# Na VPS, preencha com a URL HTTPS publica para ativar webhook.
TELEGRAM_WEBHOOK_URL=
PORTA_WEBHOOK=8080

# --- Embeddings ---
MODELO_EMBEDDING=intfloat/multilingual-e5-small

# --- Ajuste fino do RAG ---
CHUNK_TAMANHO=900
CHUNK_SOBREPOSICAO=150
TOP_K_VETORIAL=10
TOP_K_LEXICAL=10
TOP_K_FINAL=4
# Abaixo deste score o bot admite que nao sabe em vez de arriscar.
LIMIAR_SIMILARIDADE=0.62

# --- Memoria de conversa ---
# Quantas trocas anteriores do mesmo usuario entram no prompt.
HISTORICO_TURNOS=1
# Trocas mais antigas que isso (em minutos) nao contam mais como a mesma sessao.
HISTORICO_JANELA_MINUTOS=60

# --- Avaliacao automatica ---
AVALIAR_AUTOMATICAMENTE=true

# --- Privacidade ---
# Sal do hash do id do Telegram. Troque por algo aleatorio.
SAL_HASH=troque-por-algo-aleatorio

# --- Pool de conexao com o banco ---
# Segundos de espera por uma conexao livre antes de desistir e responder
# com erro amigavel em vez de deixar o usuario esperando.
DB_POOL_TIMEOUT_SEG=6

# --- Importador local (docker compose --profile import up -d import-ui) ---
PORTA_IMPORT_UI=8090
